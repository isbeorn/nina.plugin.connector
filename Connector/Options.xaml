<ResourceDictionary
    x:Class="NINA.Plugins.Connector.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:NINA.Core.Utility.Converters;assembly=NINA.Core"
    xmlns:connector="clr-namespace:NINA.Plugins.Connector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filter="clr-namespace:NINA.Core.Model;assembly=NINA.Core"
    xmlns:local="clr-namespace:NINA.Plugins.Connector.Instructions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    mc:Ignorable="d">
    <converter:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />

    <DataTemplate x:Key="Connector_Options">
        <Grid>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Auto connect equipment on start" />
            
            <CheckBox
                Grid.Column="1"
                Margin="5,5,0,0"
                HorizontalAlignment="Left"
                IsChecked="{Binding AutoConnectEquipment, Mode=TwoWay}" />

            <TextBlock
                Grid.Row="1"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Text="&#x21AA; Unpark telescope"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            
            <CheckBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="5,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsChecked="{Binding UnparkTelescope, Mode=TwoWay}"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

            <TextBlock
                Grid.Row="2"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Text="&#x21AA; Open flat device cover"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            
            <CheckBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="5,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsChecked="{Binding OpenFlatCover, Mode=TwoWay}"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

            <TextBlock
                Grid.Row="3"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Text="&#x21AA; Move to specific filter"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            
            <Grid
                Grid.Row="3"
                Grid.Column="1"
                Margin="5,5,0,0"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <CheckBox
                    VerticalAlignment="Center"
                    IsChecked="{Binding ChangeFilter, Mode=TwoWay}"
                    Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Text="{ns:Loc LblFilter}"
                    Visibility="{Binding ChangeFilter, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                
                <ComboBox
                    Grid.Column="3"
                    Height="25"
                    MinWidth="120"
                    Margin="5,0,0,0"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding Filter, Mode=TwoWay, Converter={StaticResource FilterWheelFilterConverter}}"
                    SelectedValuePath="Name"
                    Visibility="{Binding ChangeFilter, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                    
                    <ComboBox.ItemsSource>
                        <CompositeCollection>
                            <x:Static Member="filter:NullFilter.Instance" />
                            <CollectionContainer Collection="{Binding Source={StaticResource ProfileService}, Path=ActiveProfile.FilterWheelSettings.FilterWheelFilters}" />
                        </CompositeCollection>
                    </ComboBox.ItemsSource>
                    
                </ComboBox>
                
            </Grid>

            <TextBlock
                Grid.Row="4"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Text="&#x21AA; Move focuser to specific position"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            <Grid
                Grid.Row="4"
                Grid.Column="1"
                Margin="5,5,0,0"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <CheckBox
                    VerticalAlignment="Center"
                    IsChecked="{Binding MoveFocuserToPosition, Mode=TwoWay}"
                    Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Text="Position"
                    Visibility="{Binding MoveFocuserToPosition, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                
                <TextBox
                    Grid.Column="2"
                    MinWidth="50"
                    Margin="5,0,0,0"
                    Text="{Binding FocuserPosition}"
                    Visibility="{Binding MoveFocuserToPosition, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                
            </Grid>

            <TextBlock
                Grid.Row="5"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Text="&#x21AA; Move rotator to specific position"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            
            <Grid
                Grid.Row="5"
                Grid.Column="1"
                Margin="5,5,0,0"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <CheckBox
                    VerticalAlignment="Center"
                    IsChecked="{Binding MoveRotatorToPosition, Mode=TwoWay}"
                    Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Text="Position"
                    Visibility="{Binding MoveRotatorToPosition, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                
                <TextBox
                    Grid.Column="2"
                    MinWidth="50"
                    Margin="5,0,0,0"
                    Text="{Binding RotatorPosition}"
                    Visibility="{Binding MoveRotatorToPosition, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            </Grid>

            <TextBlock
                Grid.Row="6"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Text="&#x21AA; Auto cool camera"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            
            <CheckBox
                Grid.Row="6"
                Grid.Column="1"
                Margin="5,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsChecked="{Binding AutoCoolCamera, Mode=TwoWay}"
                Visibility="{Binding AutoConnectEquipment, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

            <TextBlock
                Grid.Row="7"
                Margin="0,12,0,0"
                VerticalAlignment="Center"
                Text="Custom startup connection order" />
            
            <CheckBox
                Grid.Row="7"
                Grid.Column="1"
                Margin="5,12,0,0"
                HorizontalAlignment="Left"
                IsChecked="{Binding UseCustomDeviceConnectionOrder, Mode=TwoWay}" />

            <GroupBox
                Grid.Row="8"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                Header="Connection order (top first)"
                Visibility="{Binding UseCustomDeviceConnectionOrder, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <StackPanel>
                    <AdornerDecorator>
                        <connector:ConnectionOrderListBox
                            x:Name="DeviceConnectionOrderList"
                            AutomationProperties.Name="Equipment connection order"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource PrimaryBrush}"
                            ItemsSource="{Binding DeviceConnectionOrder}"
                            KeyboardNavigation.TabNavigation="Once"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectionMode="Single"
                            VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.InputBindings>
                                <KeyBinding
                                    Key="Up"
                                    Modifiers="Alt"
                                    Command="{Binding MoveDeviceConnectionOrderUpCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=DeviceConnectionOrderList}" />
                                <KeyBinding
                                    Key="Down"
                                    Modifiers="Alt"
                                    Command="{Binding MoveDeviceConnectionOrderDownCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=DeviceConnectionOrderList}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,4" />
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="10"
                                            Height="14"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Cursor="SizeAll"
                                            Fill="{DynamicResource PrimaryBrush}"
                                            Opacity="0.55"
                                            Stretch="Uniform"
                                            ToolTip="Drag to reorder">
                                            <Path.Data>
                                                <GeometryGroup>
                                                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                                                    <EllipseGeometry Center="5,1" RadiusX="1" RadiusY="1" />
                                                    <EllipseGeometry Center="1,5" RadiusX="1" RadiusY="1" />
                                                    <EllipseGeometry Center="5,5" RadiusX="1" RadiusY="1" />
                                                    <EllipseGeometry Center="1,9" RadiusX="1" RadiusY="1" />
                                                    <EllipseGeometry Center="5,9" RadiusX="1" RadiusY="1" />
                                                </GeometryGroup>
                                            </Path.Data>
                                        </Path>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </connector:ConnectionOrderListBox>
                    </AdornerDecorator>
                    <DockPanel Margin="5,6,5,0" LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding SelectedItem, ElementName=DeviceConnectionOrderList}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button
                                Width="28"
                                Height="28"
                                AutomationProperties.Name="Move selected device up"
                                Command="{Binding MoveDeviceConnectionOrderUpCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=DeviceConnectionOrderList}"
                                Style="{StaticResource BackgroundButton}"
                                ToolTip="Move up (Alt+Up)">
                                <Path Width="14" Height="14" Data="{StaticResource ArrowUpSVG}" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Margin="4,0,0,0"
                                AutomationProperties.Name="Move selected device down"
                                Command="{Binding MoveDeviceConnectionOrderDownCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=DeviceConnectionOrderList}"
                                Style="{StaticResource BackgroundButton}"
                                ToolTip="Move down (Alt+Down)">
                                <Path Width="14" Height="14" Data="{StaticResource ArrowDownSVG}" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
